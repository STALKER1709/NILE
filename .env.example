# =============================================================================
# NILE Marketplace — variables d'environnement (EXEMPLE)
# -----------------------------------------------------------------------------
# Copie ce fichier en `.env` puis remplis les valeurs.
# NE COMMITE JAMAIS le fichier `.env` réel : il contient des secrets.
# =============================================================================

# Environnement d'exécution : "development" en local, "production" en ligne.
NODE_ENV="development"

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL)
# -----------------------------------------------------------------------------
# En local : le PostgreSQL de ta machine.
# En production : la chaîne de connexion fournie par Supabase (onglet Database).
#   - DATABASE_URL : le POOLER (port 6543) en production serverless.
#   - DIRECT_URL   : la connexion DIRECTE (port 5432), utilisée par les migrations.
# En local, les deux sont identiques.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nile_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nile_dev?schema=public"

# -----------------------------------------------------------------------------
# AUTHENTIFICATION
# -----------------------------------------------------------------------------
# Choix du fournisseur d'authentification :
#   "mock"     -> développement/tests locaux uniquement (INTERDIT en production).
#   "supabase" -> vrai fournisseur managé (production).
AUTH_PROVIDER="mock"

# Secret utilisé UNIQUEMENT par le fournisseur "mock" pour signer la session de dev.
# Génère une valeur au hasard, ex : openssl rand -hex 32
MOCK_AUTH_SECRET="dev-secret-a-remplacer-par-une-valeur-aleatoire"

# --- Supabase (nécessaire seulement quand AUTH_PROVIDER="supabase") ---
# Ces valeurs viennent de ton projet Supabase (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Clé secrète côté serveur (Settings > API > service_role). NE JAMAIS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=""

# URL publique du site (SEO : sitemap, Open Graph). En production : l'URL Vercel
# ou le domaine final. Défaut : https://nile-beige.vercel.app
NEXT_PUBLIC_SITE_URL=""

# ⚠️ Mot de passe oublié (Supabase) : ajouter l'URL de retour aux « Redirect
# URLs » autorisées dans Supabase (Authentication > URL Configuration) :
#   https://TON-DOMAINE/auth/callback
# En local : http://localhost:3000/auth/callback

# -----------------------------------------------------------------------------
# PAIEMENT (branché en Phase 3 — laissé vide pour l'instant)
# -----------------------------------------------------------------------------
# "mock"     -> simulation de paiement (développement/tests).
# "monetbil" -> vrai agrégateur (production).
PAYMENT_PROVIDER="mock"
# Clés Monetbil (obtenues sur https://www.monetbil.com/services). Requises quand
# PAYMENT_PROVIDER="monetbil".
MONETBIL_SERVICE_KEY=""
MONETBIL_SERVICE_SECRET=""

# --- HR-Skills Pay (PAYMENT_PROVIDER="hrskills") -----------------------------
# Dashboard > Développeurs. Clé A publique (en-tête Authorization) et Clé B
# secrète (échangée contre un token de transaction). La Clé B ne doit JAMAIS
# être exposée côté navigateur.
# Préfixe hrsk_*_test_* = sandbox (aucun paiement réel : montant PAIR ->
# succès, IMPAIR -> échec). Préfixe hrsk_*_live_* = production, KYC approuvé.
HRSKILLS_CLE_A=""
HRSKILLS_CLE_B=""
# Secret de signature des webhooks (Dashboard > Paramètres > Webhooks).
# Sans lui, une notification de paiement ne peut pas être authentifiée :
# l'intégration refuse alors de démarrer.
HRSKILLS_WEBHOOK_SECRET=""
# URL de l'API. Sandbox et production partagent la même : c'est le préfixe des
# clés qui distingue les environnements.
HRSKILLS_BASE_URL="https://api.hrskills-pay.com"
# Secret pour signer les notifications simulées du fournisseur "mock" (dev).
MOCK_PAYMENT_SECRET="dev-payment-secret-local"

# -----------------------------------------------------------------------------
# STOCKAGE DES IMAGES PRODUIT
# -----------------------------------------------------------------------------
# "local"    -> dossier public/uploads (développement, aucun compte requis).
# "supabase" -> bucket Supabase Storage (production).
STORAGE_PROVIDER="local"
SUPABASE_STORAGE_BUCKET="produits"

# -----------------------------------------------------------------------------
# EMAIL TRANSACTIONNEL (confirmations de commande)
# -----------------------------------------------------------------------------
# "mock"  -> journalise seulement (développement, aucun compte requis).
# "brevo" -> envoi réel via Brevo (https://www.brevo.com — palier gratuit,
#            fonctionne avec une simple adresse expéditrice validée,
#            pas besoin de posséder un domaine).
EMAIL_PROVIDER="mock"
# Clé API Brevo (Settings > SMTP & API > API Keys). Requise quand
# EMAIL_PROVIDER="brevo".
BREVO_API_KEY=""
# Adresse expéditrice VALIDÉE dans Brevo (Senders & IP > Senders).
EMAIL_EXPEDITEUR=""
EMAIL_EXPEDITEUR_NOM="NILE Marketplace"

# -----------------------------------------------------------------------------
# NOTIFICATIONS DE COMMANDE PAR WHATSAPP (WhatsApp Cloud API, Meta)
# -----------------------------------------------------------------------------
# "mock" -> journalise seulement (développement, aucun compte requis).
# "meta" -> envoi réel via l'API Cloud de Meta (https://developers.facebook.com).
WHATSAPP_PROVIDER="mock"
# WhatsApp Manager > le numéro > Identifiant du numéro de téléphone.
WHATSAPP_PHONE_NUMBER_ID=""
# Business Settings > System Users > (ton system user) > Générer un token
# (accès permanent, PAS le token de test qui expire en 24h).
WHATSAPP_TOKEN=""
# App Dashboard > Settings > Basic > App Secret. Sert à vérifier que les
# webhooks reçus viennent bien de Meta (signature HMAC-SHA256).
WHATSAPP_APP_SECRET=""
# Chaîne que TU choisis (n'importe quelle valeur aléatoire), à recopier telle
# quelle dans WhatsApp Manager > Configuration > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=""
# Nom du template "utility" approuvé par Meta pour les mises à jour de statut
# hors fenêtre gratuite de 24h. Laisser vide tant qu'aucun template n'est
# validé : ces envois sont alors journalisés, pas bloquants.
WHATSAPP_TEMPLATE_STATUT=""

# -----------------------------------------------------------------------------
# TÂCHES PLANIFIÉES (rappels de confirmation de réception)
# -----------------------------------------------------------------------------
# Secret partagé entre l'app et le planificateur externe (GitHub Actions), qui
# appelle /api/cron/rappels-livraison toutes les ~10 minutes. Vercel Hobby ne
# permet qu'une exécution planifiée par jour, d'où le déclencheur externe.
# Génère une valeur au hasard (32+ caractères) :  openssl rand -hex 32
# Doit être identique ici et dans les secrets du dépôt GitHub (CRON_SECRET).
# Vide = la route est inactive (503), jamais ouverte sans authentification.
CRON_SECRET=""

# -----------------------------------------------------------------------------
# GARDE-FOUS COMMANDE / COD (valeurs par défaut, surchargées ensuite en base)
# -----------------------------------------------------------------------------
# Plafond en FCFA (XAF) d'une commande payable à la livraison.
COD_PLAFOND_XAF="150000"
# Nombre max de commandes non abouties (refus/annulations) toléré par acheteur.
COD_MAX_COMMANDES_NON_ABOUTIES="3"

# -----------------------------------------------------------------------------
# CONTACT / SUPPORT CLIENT (affichés seulement si renseignés)
# -----------------------------------------------------------------------------
# Numéro WhatsApp Business au format international SANS + ni espaces
# (ex. 2376XXXXXXXX). Active la page /contact et la bulle WhatsApp flottante.
CONTACT_WHATSAPP=""
# Email de support affiché sur la page /contact.
CONTACT_EMAIL=""
# Délai de livraison affiché aux acheteurs (fiche produit + commande).
# Ex : "24-72 h à Douala et Yaoundé, 2 à 5 jours ailleurs"
DELAI_LIVRAISON_TEXTE=""

# -----------------------------------------------------------------------------
# NOTIFICATIONS PUSH (nouvelles commandes -> téléphone du vendeur/admin)
# -----------------------------------------------------------------------------
# Génère la paire de clés VAPID avec :  npx web-push generate-vapid-keys
# La clé publique est visible côté client ; la privée reste secrète (Vercel).
# Les deux sont requises pour activer le push ; sinon la fonction est inactive.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
