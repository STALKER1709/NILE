// =============================================================================
// NILE Marketplace — schéma de base de données
// Marketplace hybride (stock propre + vendeurs tiers), marché Cameroun.
// Argent : entiers FCFA (XAF), jamais de décimales.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (port 5432) pour les migrations quand DATABASE_URL passe
  // par le pooler Supabase (port 6543). En local, identique à DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ------------------------------- ÉNUMÉRATIONS --------------------------------

enum Role {
  ACHETEUR
  VENDEUR
  ADMIN
}

enum StatutUtilisateur {
  ACTIF
  SUSPENDU
}

enum StatutVendeur {
  EN_ATTENTE
  VALIDE
  REJETE
  SUSPENDU
}

enum StatutProduit {
  BROUILLON
  ACTIF
  INACTIF
  EN_MODERATION
  REJETE
  // Suppression vendeur : soft delete. Disparaît de la liste principale et
  // du catalogue public, mais la ligne reste (intégrité des commandes
  // passées) et le vendeur peut le restaurer depuis sa corbeille.
  SUPPRIME
}

// Statut du cycle de vie logistique de la commande (indépendant du paiement).
enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
  REFUSEE
}

// Cycle de vie d'un versement au vendeur.
enum StatutReversement {
  DEMANDE // demandé par le vendeur, pas encore payé
  PAYE
  REJETE
}

// Statut du paiement (indépendant du statut de la commande).
enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
  REMBOURSE
}

enum ModePaiement {
  MONETBIL
  COD
}

// Type de réduction d'une promotion vendeur.
enum TypePromotion {
  POURCENTAGE
  MONTANT
}

enum StatutLivraison {
  EN_ATTENTE
  AFFECTEE
  EN_TRANSIT
  LIVREE
  ECHEC
  RETOURNEE
}

// Comment la réception a été attestée. Distingue une preuve obtenue chez le
// client d'un déblocage administratif, qui n'a pas la même valeur.
enum ModeConfirmationLivraison {
  SCAN // QR de l'acheteur scanné par le livreur, chez le client
  MANUEL // code dicté par l'acheteur, saisi par le livreur (sans caméra)
  ADMIN // forcé par un administrateur, motif obligatoire
}

// Réconciliation du cash encaissé par le transporteur (paiement à la livraison).
enum StatutCashCOD {
  NON_APPLICABLE
  NON_COLLECTE
  COLLECTE
  REVERSE
}

// --------------------------------- ENTITÉS -----------------------------------

// Profil applicatif. L'identité (mot de passe/session) est gérée par le
// fournisseur d'authentification (Supabase en prod, mock en dev) ; `id` est
// l'identifiant de l'utilisateur d'auth. L'AUTORISATION (rôle) vit ici.
model Utilisateur {
  id                           String            @id // = id de l'utilisateur d'auth
  nom                          String
  telephone                    String
  email                        String            @unique
  role                         Role              @default(ACHETEUR)
  statut                       StatutUtilisateur @default(ACTIF)
  // Compteur anti-fraude COD : commandes refusées/annulées à la livraison.
  nbCommandesNonAbouties       Int               @default(0)
  // Dernier message WhatsApp reçu de cet utilisateur + 24h (fenêtre de
  // service Meta) : tant qu'elle est dans le futur, on peut lui répondre
  // gratuitement en texte libre plutôt qu'avec un template payant.
  whatsappFenetreOuverteJusqua DateTime?
  dateCreation                 DateTime          @default(now())

  vendeur         Vendeur?
  abonnementsPush AbonnementPush[]
  panier          Panier?
  commandes       Commande[]
  avis            Avis[]

  @@index([role])
}

// Justificatif d'identité pour le fournisseur "mock" UNIQUEMENT (dev/tests).
// En production (AUTH_PROVIDER="supabase"), cette table n'est pas utilisée :
// Supabase gère les identifiants. Aucun secret de prod n'y est stocké.
model MockCredential {
  authId       String   @id
  email        String   @unique
  motDePasse   String // hash scrypt (dev uniquement)
  dateCreation DateTime @default(now())
}

model Vendeur {
  id                String        @id @default(uuid())
  utilisateurId     String        @unique
  utilisateur       Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  nomBoutique       String
  description       String?
  statutValidation  StatutVendeur @default(EN_ATTENTE)
  // Infos de reversement (n° MoMo/Orange, etc.). JSON pour rester flexible.
  infosPaiement     Json?
  // La "boutique maison" = le stock propre de la plateforme.
  estBoutiqueMaison Boolean       @default(false)
  dateCreation      DateTime      @default(now())

  produits       Produit[]
  lignesCommande LigneCommande[]
  reversements   Reversement[]
  promotions     Promotion[]

  @@index([statutValidation])
}

// Catégories en arborescence (parent_id) — extensible à toute catégorie.
model Categorie {
  id           String      @id @default(uuid())
  nom          String
  slug         String      @unique
  parentId     String?
  parent       Categorie?  @relation("CategorieArbre", fields: [parentId], references: [id])
  enfants      Categorie[] @relation("CategorieArbre")
  ordre        Int         @default(0)
  dateCreation DateTime    @default(now())

  produits Produit[]

  @@index([parentId])
}

model Produit {
  id           String        @id @default(uuid())
  vendeurId    String
  vendeur      Vendeur       @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  categorieId  String
  categorie    Categorie     @relation(fields: [categorieId], references: [id])
  titre        String
  slug         String        @unique
  description  String
  prix         Int // FCFA (XAF), entier
  // Marque, purement descriptive : elle sert à chercher et à filtrer, jamais à
  // séparer des stocks. Un vendeur ne tient pas un stock « par marque ».
  marque       String?
  // ⚠️ Stock HISTORIQUE, conservé le temps de la bascule vers les variantes.
  // La quantité disponible vit désormais sur `VarianteProduit.stock` : tout
  // produit en possède au moins une, y compris ceux sans taille ni couleur.
  // Ce champ ne doit plus être ni lu ni décrémenté.
  stock        Int           @default(0)
  statut       StatutProduit @default(BROUILLON)
  noteMoyenne  Float         @default(0) // dénormalisé (mis à jour depuis les avis)
  nbAvis       Int           @default(0)
  dateCreation DateTime      @default(now())
  dateMaj      DateTime      @updatedAt

  variantes      VarianteProduit[]
  images         ImageProduit[]
  avis           Avis[]
  lignesPanier   LignePanier[]
  lignesCommande LigneCommande[]
  promotions     Promotion[]

  @@index([categorieId])
  @@index([vendeurId])
  @@index([statut])
}

// Déclinaison vendable d'un produit : une taille, une couleur, un stock.
//
// TOUT produit en possède au moins une, même sans taille ni couleur — celle-ci
// porte alors deux chaînes vides. Cette uniformité est délibérée : le stock
// vit toujours au même endroit, et le décrément atomique du tunnel de commande
// n'a qu'un seul chemin de code au lieu d'un cas particulier par produit.
//
// Pas de prix par variante : un XL et un M coûtent le même prix. C'est une
// dimension de complexité en moins, et une source d'écart en moins sur le
// chemin de l'argent.
model VarianteProduit {
  id        String  @id @default(uuid())
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  // Chaîne VIDE et non `NULL` quand l'axe ne s'applique pas : Postgres traite
  // deux `NULL` comme distincts dans un index unique, ce qui laisserait créer
  // deux fois la même variante.
  taille    String  @default("")
  couleur   String  @default("")
  stock     Int     @default(0)
  // Retirer une déclinaison sans perdre l'historique des commandes qui la
  // référencent.
  actif     Boolean @default(true)

  lignesPanier   LignePanier[]
  lignesCommande LigneCommande[]

  @@unique([produitId, taille, couleur])
  @@index([produitId])
}

model ImageProduit {
  id        String  @id @default(uuid())
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  url       String // URL publique affichable
  chemin    String? // clé de stockage (pour suppression du fichier)
  ordre     Int     @default(0)
  alt       String?

  @@index([produitId])
}

model Panier {
  id            String        @id @default(uuid())
  utilisateurId String        @unique
  utilisateur   Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  lignes        LignePanier[]
  dateCreation  DateTime      @default(now())
}

model LignePanier {
  id         String          @id @default(uuid())
  panierId   String
  panier     Panier          @relation(fields: [panierId], references: [id], onDelete: Cascade)
  produitId  String
  produit    Produit         @relation(fields: [produitId], references: [id], onDelete: Cascade)
  // C'est la VARIANTE qui est mise au panier : deux tailles du même t-shirt
  // sont deux lignes distinctes, avec chacune son stock.
  varianteId String
  variante   VarianteProduit @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  quantite   Int

  // L'unicité porte sur la variante et non sur le produit, sinon ajouter un M
  // après un XL écraserait la première ligne.
  @@unique([panierId, varianteId])
  @@index([produitId])
}

model Commande {
  id             String         @id @default(uuid())
  numero         String         @unique // référence lisible (ex : NILE-2026-000123)
  acheteurId     String
  acheteur       Utilisateur    @relation(fields: [acheteurId], references: [id])
  statutCommande StatutCommande @default(EN_ATTENTE)
  statutPaiement StatutPaiement @default(EN_ATTENTE)
  modePaiement   ModePaiement
  // Ce que l'acheteur paie RÉELLEMENT : somme des sous-totaux moins `remise`.
  total          Int // FCFA (XAF)
  // Remise accordée par un code promo, en FCFA. Retranchée du total mais JAMAIS
  // des `LigneCommande.sousTotal` : le vendeur est payé sur le prix plein, donc
  // la remise sort entièrement de la marge de NILE. C'est le sens du choix
  // « codes valables en Mobile Money uniquement » — NILE ne remise que l'argent
  // qui transite par elle.
  remise         Int            @default(0)
  // Code saisi, figé au moment de la commande. Comme le prix unitaire : si le
  // code est modifié ou supprimé plus tard, l'historique comptable ne bouge pas.
  codePromo      String?

  // Adresse figée au moment de la commande — adressage informel camerounais.
  destNom       String
  destTelephone String
  ville         String
  quartier      String
  reperes       String? // points de repère libres
  gpsLat        Float?
  gpsLng        Float?

  dateCreation DateTime @default(now())
  dateMaj      DateTime @updatedAt

  lignes    LigneCommande[]
  paiements Paiement[]
  livraison Livraison?

  @@index([acheteurId])
  @@index([statutCommande])
  @@index([statutPaiement])
}

model LigneCommande {
  id           String           @id @default(uuid())
  commandeId   String
  commande     Commande         @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId    String
  produit      Produit          @relation(fields: [produitId], references: [id])
  // Indispensable : une commande peut mêler plusieurs vendeurs (règlements répartis).
  vendeurId    String
  vendeur      Vendeur          @relation(fields: [vendeurId], references: [id])
  // Variante commandée. Nullable pour les commandes antérieures aux
  // déclinaisons : leur ligne n'en désigne aucune, et elle ne doit pas être
  // réécrite après coup.
  varianteId   String?
  variante     VarianteProduit? @relation(fields: [varianteId], references: [id])
  titreProduit String // snapshot du titre au moment de la commande
  // Instantanés de la déclinaison, au même titre que le titre et le prix : le
  // vendeur peut renommer « Bleu » en « Bleu ciel », la commande passée doit
  // continuer de dire ce qui a été acheté.
  taille       String           @default("")
  couleur      String           @default("")
  prixUnitaire Int // snapshot du prix (FCFA)
  quantite     Int
  sousTotal    Int // prixUnitaire * quantite

  @@index([commandeId])
  @@index([vendeurId])
}

model Paiement {
  id           String         @id @default(uuid())
  commandeId   String
  commande     Commande       @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  mode         ModePaiement
  montant      Int // FCFA
  statut       StatutPaiement @default(EN_ATTENTE)
  reference    String?        @unique // réf transaction Monetbil
  payload      Json? // charge utile brute du callback vérifié
  dateCreation DateTime       @default(now())
  dateMaj      DateTime       @updatedAt

  @@index([commandeId])
}

model Livraison {
  id                       String                     @id @default(uuid())
  commandeId               String                     @unique
  commande                 Commande                   @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  transporteur             String? // texte libre au MVP (suivi manuel)
  statut                   StatutLivraison            @default(EN_ATTENTE)
  preuveUrl                String? // preuve de livraison (photo/signature)
  statutCash               StatutCashCOD              @default(NON_APPLICABLE)
  montantCashCollecte      Int? // FCFA encaissés à la livraison (COD)
  dateAffectation          DateTime?
  dateLivraison            DateTime?
  note                     String?
  // Attestation de réception par l'ACHETEUR. Depuis la remise par scan, c'est
  // ELLE qui fait passer la commande à LIVREE — et donc qui rend le vendeur
  // payable, puisque le calcul des reversements ne compte que les commandes
  // LIVREE et PAYEE.
  confirmationAcheteur     DateTime?
  // Comment l'attestation a été obtenue. Trace indispensable : un forçage
  // administrateur n'a pas la même valeur probante qu'un code scanné.
  modeConfirmation         ModeConfirmationLivraison?
  // Motif obligatoire quand un administrateur force la livraison sans code
  // (acheteur injoignable, téléphone déchargé, aucun réseau sur place…).
  forcageMotif             String?
  // Secret propre à cette livraison, d'où découle le code tournant affiché à
  // l'acheteur. Tiré au sort à la première demande, jamais exposé au client.
  secretReception          String?
  // Rappel push « avez-vous bien reçu ? » envoyé 30 min après la livraison
  // déclarée. Un seul rappel par commande, jamais de relance en boucle.
  rappelConfirmationEnvoye Boolean                    @default(false)

  // Retrouver les livraisons à rappeler sans balayer toute la table. Nom
  // explicite : l'auto-généré dépasserait la limite de 63 caractères de
  // Postgres et serait tronqué silencieusement.
  @@index([statut, confirmationAcheteur, rappelConfirmationEnvoye], map: "Livraison_rappel_idx")
}

model Avis {
  id           String      @id @default(uuid())
  produitId    String
  produit      Produit     @relation(fields: [produitId], references: [id], onDelete: Cascade)
  acheteurId   String
  acheteur     Utilisateur @relation(fields: [acheteurId], references: [id])
  note         Int // 1 à 5
  commentaire  String?
  dateCreation DateTime    @default(now())

  @@unique([produitId, acheteurId]) // un avis par acheteur et par produit
  @@index([produitId])
}

// Garde-fous / paramètres éditables par l'admin (plafond COD, etc.).
// Clé/valeur pour rester flexible ; valeurs par défaut dans les variables d'env.
model Configuration {
  cle     String   @id
  valeur  Json
  dateMaj DateTime @updatedAt
}

// Rate limiting (anti-abus) : une ligne par tentative sensible (connexion,
// inscription, réinitialisation). Les lignes hors fenêtre sont purgées au fil
// de l'eau par le module securite/rate-limit.
model EvenementAbus {
  id           String   @id @default(uuid())
  cle          String // ex. "connexion:1.2.3.4:email@x.cm"
  dateCreation DateTime @default(now())

  @@index([cle, dateCreation])
}

// Abonnement Web Push d'un utilisateur (vendeur/admin) : permet de le
// prévenir instantanément d'une nouvelle commande sur son téléphone.
model AbonnementPush {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  endpoint      String      @unique
  p256dh        String
  auth          String
  dateCreation  DateTime    @default(now())

  @@index([utilisateurId])
}

// Reversement d'argent à un vendeur tiers (transfert MoMo/OM fait à la main
// par l'admin, enregistré ici). Le solde dû = ventes livrées ET payées,
// moins la commission NILE, moins la somme des reversements.
model Reversement {
  id             String            @id @default(uuid())
  vendeurId      String
  vendeur        Vendeur           @relation(fields: [vendeurId], references: [id])
  montant        Int // FCFA versés au vendeur
  // DEMANDE réserve le montant sur le solde du vendeur sans être un paiement :
  // sans cette réservation, il pourrait demander deux fois la même somme.
  // Le défaut PAYE sert la migration : les lignes existantes sont des
  // transferts réellement effectués. Le code passe toujours le statut.
  statut         StatutReversement @default(PAYE)
  commentaire    String? // référence du transfert, ou motif du refus
  dateCreation   DateTime          @default(now())
  dateTraitement DateTime? // date du paiement ou du refus par l'admin

  @@index([vendeurId])
  @@index([statut])
}

// Promotion créée par un vendeur : réduction sur UN produit (`produitId`
// renseigné) ou sur toute sa boutique (`produitId` nul). Le prix réduit est
// toujours calculé à la volée depuis `Produit.prix` — jamais stocké — pour
// rester cohérent si le vendeur change son prix pendant la promotion.
model Promotion {
  id           String        @id @default(uuid())
  vendeurId    String
  vendeur      Vendeur       @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  produitId    String?
  produit      Produit?      @relation(fields: [produitId], references: [id], onDelete: Cascade)
  type         TypePromotion
  valeur       Int // pourcentage (1-90) ou montant FCFA à déduire, selon `type`
  dateDebut    DateTime
  dateFin      DateTime
  annulee      Boolean       @default(false)
  dateCreation DateTime      @default(now())

  @@index([vendeurId])
  @@index([produitId])
  @@index([dateDebut, dateFin])
}

// Code promotionnel émis par NILE (jamais par un vendeur : ceux-ci disposent
// déjà des `Promotion`, et deux systèmes de remise qui se recouvrent seraient
// deux systèmes à maintenir).
//
// La remise sort de la marge de NILE, pas de celle du vendeur — d'où la
// restriction au Mobile Money : c'est le seul mode où l'argent transite par la
// plateforme. En paiement à la livraison, NILE n'encaisse rien et n'aurait donc
// rien à remiser.
model CodePromo {
  id            String        @id @default(uuid())
  // Normalisé en majuscules sans espaces à l'écriture comme à la lecture :
  // l'acheteur tape « bienvenue 10 », on cherche « BIENVENUE10 ».
  code          String        @unique
  type          TypePromotion
  valeur        Int // pourcentage (1-100) ou montant FCFA, selon `type`
  // Plafond d'une remise en pourcentage, en FCFA. Sans lui, « -20 % » sur un
  // panier de 500 000 coûterait 100 000 à la plateforme. Nul = sans plafond.
  plafondRemise Int?
  // Panier minimum exigé (FCFA). 0 = aucune condition.
  minPanier     Int           @default(0)
  dateDebut     DateTime
  dateFin       DateTime
  // Nombre total d'utilisations autorisées, toutes personnes confondues :
  // c'est ce qui borne le budget d'une campagne. Nul = illimité.
  quotaTotal    Int?
  // Interrupteur manuel, pour couper un code sans toucher à ses dates.
  actif         Boolean       @default(true)
  dateCreation  DateTime      @default(now())

  utilisations UtilisationCodePromo[]

  @@index([dateDebut, dateFin])
}

// Une utilisation effective d'un code, rattachée à la commande qu'elle a
// remisée. Sert à deux choses : compter les utilisations pour le quota, et
// empêcher un même acheteur d'utiliser deux fois le même code.
model UtilisationCodePromo {
  id            String    @id @default(uuid())
  codePromoId   String
  codePromo     CodePromo @relation(fields: [codePromoId], references: [id], onDelete: Cascade)
  utilisateurId String
  // Une commande ne porte qu'un seul code.
  commandeId    String    @unique
  remise        Int // FCFA effectivement déduits
  dateCreation  DateTime  @default(now())

  // Un acheteur ne peut utiliser un code qu'une fois. Garanti par la BASE et
  // non par une vérification applicative : deux commandes simultanées
  // passeraient toutes deux un simple test de lecture.
  @@unique([codePromoId, utilisateurId])
  @@index([codePromoId])
}

// Actualité/brief publié par NILE à destination des vendeurs. Diffusion à
// SENS UNIQUE (l'admin publie, les vendeurs consultent) : ce n'est pas une
// messagerie interne, exclue du MVP par CLAUDE.md.
model Annonce {
  id           String   @id @default(uuid())
  titre        String
  contenu      String
  epinglee     Boolean  @default(false)
  dateCreation DateTime @default(now())
  dateMaj      DateTime @updatedAt

  @@index([epinglee, dateCreation])
}
